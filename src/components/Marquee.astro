---
import Logo from './Logo.astro';
import { t } from '../data/content';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const items = t(lang).marquee;
---

<section class="marquee" aria-label={items.join(', ')}>
  <div class="marquee__track" data-marquee aria-hidden="true">
    {
      [0, 1].map(() => (
        <div class="marquee__group">
          {items.map((item, i) => (
            <>
              <span class:list={['marquee__item', { 'is-outline': i % 2 === 1 }]}>{item}</span>
              <Logo class="marquee__sep" />
            </>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .marquee {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-block: 1px solid var(--faint);
    overflow: hidden;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
  .marquee__group {
    display: flex;
    align-items: center;
    flex: none;
  }
  .marquee__item {
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    font-weight: 800;
    font-stretch: 118%;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .marquee__item.is-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--fg);
  }
  .marquee__sep {
    width: clamp(1.75rem, 3.6vw, 3.25rem);
    margin-inline: clamp(1.5rem, 3vw, 3rem);
    color: var(--accent-fg);
    flex: none;
  }
</style>
