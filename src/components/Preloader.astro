---
import Logo from './Logo.astro';
---

<!--
  Logo reveal pri otvorení stránky:
  obrys loga sa nakreslí, logo sa vyplní a obrazovka sa odhalí smerom nahor.
  Animácia je v src/scripts/main.ts (runPreloader).
-->
<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__logo" data-preloader-logo>
    <Logo />
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--ink);
    color: var(--paper);
    display: none;
    place-items: center;
  }
  :global(.is-first) .preloader {
    display: grid;
  }
  .preloader__logo {
    width: clamp(84px, 10vw, 140px);
  }
  /* Štartovný stav: iba neviditeľný obrys, výplň a kreslenie dorieši GSAP */
  .preloader__logo :global(path) {
    fill: currentColor;
    fill-opacity: 0;
    stroke: var(--brand);
    stroke-width: 7;
    stroke-linejoin: round;
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
  }
</style>
