---
/** Farebná žiara na pozadí sekcie (rodič: position: relative) */
interface Props {
  /** Rozloženie žiary */
  variant: 'head' | 'body' | 'soft';
  parallax?: boolean;
}
const { variant, parallax = true } = Astro.props;
---

<div class:list={['glow', `glow--${variant}`]} aria-hidden="true">
  <span class="glow__blob glow__blob--main" data-parallax={parallax ? '-16' : undefined}></span>
  <span class="glow__blob glow__blob--second" data-parallax={parallax ? '-34' : undefined}></span>
</div>

<style>
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: var(--glow-blend);
  }
  .glow__blob {
    position: absolute;
    border-radius: 50%;
    -webkit-mask-image: radial-gradient(closest-side, #000 0%, rgb(0 0 0 / 0.55) 45%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 0%, rgb(0 0 0 / 0.55) 45%, transparent 100%);
  }
  .glow__blob--main {
    background: var(--glow-main);
    opacity: var(--glow-main-opacity, var(--glow-opacity));
  }
  .glow__blob--second {
    background: var(--glow-second);
    opacity: var(--glow-second-opacity, var(--glow-opacity));
  }

  /* Hlavička */
  .glow--head .glow__blob--main {
    width: 62vw;
    height: 62vw;
    right: -18vw;
    top: -22vw;
  }
  .glow--head .glow__blob--second {
    width: 32vw;
    height: 32vw;
    left: -12vw;
    top: 52%;
  }

  /* Text projektu */
  .glow--body .glow__blob--main {
    width: 52vw;
    height: 52vw;
    left: -24vw;
    top: -6%;
  }
  .glow--body .glow__blob--second {
    width: 38vw;
    height: 38vw;
    right: -14vw;
    top: 34%;
  }

  /* Jemná žiara */
  .glow--soft {
    opacity: 0.7;
  }
  .glow--soft .glow__blob--main {
    width: 46vw;
    height: 46vw;
    right: -10vw;
    top: 50%;
    translate: 0 -50%;
  }
  .glow--soft .glow__blob--second {
    width: 26vw;
    height: 26vw;
    left: 20vw;
    bottom: -14vw;
  }

  /* Mobil */
  @media (max-width: 900px) {
    .glow--head .glow__blob--main {
      width: 130vw;
      height: 130vw;
      right: -55vw;
      top: -50vw;
    }
    .glow--head .glow__blob--second {
      width: 80vw;
      height: 80vw;
      left: -45vw;
      top: 45%;
    }
    .glow--body {
      opacity: 0.75;
    }
    .glow--body .glow__blob--main {
      width: 110vw;
      height: 110vw;
      left: -70vw;
      top: 0;
    }
    .glow--body .glow__blob--second {
      width: 90vw;
      height: 90vw;
      right: -55vw;
      top: 45%;
    }
    .glow--soft .glow__blob--main {
      width: 100vw;
      height: 100vw;
      right: -45vw;
    }
    .glow--soft .glow__blob--second {
      width: 70vw;
      height: 70vw;
      left: -30vw;
      bottom: -40vw;
    }
  }
</style>
