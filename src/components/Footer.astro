---
import Logo from './Logo.astro';
import ContactForm from './ContactForm.astro';
import { t } from '../data/content';
import { site, fullName } from '../data/site';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t(lang);
const socials = site.socials.filter((s) => s.url);
const year = new Date().getFullYear();
---

<footer class="footer" id="contact" data-footer>
  <div class="footer__panel" data-footer-panel>
    <div class="container footer__inner">
      <div class="footer__top">
        <span class="mono footer__label">{c.contact.label}</span>
      </div>

      <h2 class="footer__title display" data-split-lines>
        {c.contact.title.map((line) => <span class="footer__line">{line}</span>)}
      </h2>

      <div class="footer__grid">
        <div class="footer__form">
          <ContactForm lang={lang} />
        </div>

        <aside class="footer__aside">
          <p class="footer__text" data-reveal>{c.contact.text}</p>

          <div class="footer__mail" data-reveal>
            <span class="mono footer__muted">{c.contact.orEmail}</span>
            <a href={`mailto:${site.email}`} class="footer__email">
              <span>{site.email}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg>
            </a>
            <button class="footer__copy mono" type="button" data-copy={site.email} data-copied={c.contact.copied}>
              <span class="roll"><span data-copy-text>{c.contact.copy}</span><span aria-hidden="true">{c.contact.copy}</span></span>
            </button>
          </div>

          {
            socials.length > 0 && (
              <div class="footer__socials" data-reveal>
                <span class="mono footer__muted">{c.contact.socials}</span>
                <ul>
                  {socials.map((s) => (
                    <li>
                      <a href={s.url} target="_blank" rel="noopener noreferrer" class="footer__social">
                        <span class="roll">
                          <span>{s.label}</span>
                          <span aria-hidden="true">{s.label}</span>
                        </span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>

      <div class="footer__bottom mono">
        <span class="footer__brand"><Logo class="footer__logo" /> © {year} {fullName}</span>
        <span class="footer__muted footer__made">{c.footer.made}</span>
        <button type="button" class="footer__top-btn" data-scroll-top>
          <span class="roll"><span>{c.footer.top} ↑</span><span aria-hidden="true">{c.footer.top} ↑</span></span>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: 0 0 0;
  }
  .footer__panel {
    background: var(--brand);
    color: var(--ink);
    /* Na farebnej ploche musí byť aj „tlmený“ text plne tmavý, inak nesplní kontrast 4.5:1 */
    --muted: var(--ink);
    --faint: color-mix(in srgb, var(--ink) 18%, transparent);
    --accent-fg: var(--ink);
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: clip;
  }
  .footer__panel ::selection {
    background: var(--ink);
    color: var(--brand);
  }
  .footer__inner {
    padding-top: clamp(4rem, 9vw, 8rem);
    padding-bottom: 1.75rem;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .footer__top {
    display: flex;
    justify-content: space-between;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .footer__label::before {
    content: '● ';
    color: var(--ink);
  }
  .footer__title {
    font-size: clamp(2rem, 9.6vw, 11.5rem);
    display: flex;
    flex-direction: column;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    margin-top: clamp(3.5rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    align-items: start;
  }
  .footer__form {
    grid-column: 1 / span 8;
  }
  .footer__aside {
    grid-column: 10 / span 3;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    position: sticky;
    top: calc(var(--header-h) + 1rem);
  }
  .footer__text {
    font-size: var(--step-1);
    line-height: 1.35;
    max-width: 26ch;
  }
  .footer__mail {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--faint);
  }
  .footer__email {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 2px no-repeat;
    transition: background-size 0.7s var(--ease-out);
    overflow-wrap: anywhere;
  }
  .footer__email:hover {
    background-size: 100% 2px;
  }
  .footer__email svg {
    width: 0.8em;
    flex: none;
    transition: transform 0.6s var(--ease-out);
  }
  .footer__email:hover svg {
    transform: rotate(45deg);
  }
  .footer__copy {
    padding: 0.6em 1em;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--faint);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .footer__copy:hover {
    background: var(--ink);
    color: var(--brand);
  }
  .footer__socials {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer__social {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--faint);
    font-weight: 600;
  }
  .footer__social svg {
    width: 1em;
    transition: transform 0.5s var(--ease-out);
  }
  .footer__social:hover svg {
    transform: rotate(45deg);
  }
  .footer__muted {
    color: var(--muted);
  }
  .footer__bottom {
    margin-top: auto;
    padding-top: 1.5rem;
    padding-right: 68px; /* miesto pre plávajúce tlačidlo späť hore */
    border-top: 1px solid var(--faint);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    align-items: center;
  }
  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .footer__logo {
    width: 16px;
  }
  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    .footer__form,
    .footer__aside {
      grid-column: 1;
    }
    .footer__aside {
      position: static;
    }
  }
</style>
