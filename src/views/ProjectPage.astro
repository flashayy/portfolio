---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Glow from '../components/Glow.astro';
import { t } from '../data/content';
import { getProjects, type Project } from '../data/projects';
import { paths, otherLang, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  project: Project;
  next: Project;
}
const { lang, project, next } = Astro.props;
const c = t(lang);
const d = project.data;
const { Content } = await render(project);

const other = otherLang(lang);
const translated = (await getProjects(other)).some((p) => p.slug === project.slug);
const alternate = translated ? paths.project(other, project.slug) : paths.work(other);

const meta = [
  d.client && { label: c.project.client, value: d.client },
  { label: c.project.year, value: String(d.year) },
  { label: c.project.role, value: d.role },
  d.stack.length > 0 && { label: c.project.stack, value: d.stack.join(', ') },
].filter(Boolean) as { label: string; value: string }[];
---

<Base lang={lang} alternate={alternate} title={d.title} description={d.summary}>
  <article class:list={['project', `project--${d.accent}`]}>
    <div class="project__zone">
    <Glow variant="head" />
    <header class="project__head container">
      <a href={paths.work(lang)} class="project__back mono" data-intro>
        <span aria-hidden="true">←</span>
        <span class="roll"><span>{c.project.back}</span><span aria-hidden="true">{c.project.back}</span></span>
      </a>

      <span class="label mono project__cat" data-intro>{c.work.categories[d.category]}</span>
      <h1 class="project__title display" data-intro-title>{d.title}</h1>

      <div class="project__intro">
        <p class="project__summary" data-intro>{d.summary}</p>
        <dl class="project__meta">
          {
            meta.map((m) => (
              <div data-intro>
                <dt class="mono muted">{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))
          }
        </dl>
        {
          d.url && (
            <a href={d.url} target="_blank" rel="noopener noreferrer" class="btn project__live" data-intro>
              <span class="roll"><span>{c.project.live}</span><span aria-hidden="true">{c.project.live}</span></span>
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </header>
    </div>

    <div class="project__cover container" data-cover>
      <div class="project__cover-frame" data-cover-frame>
        <Image
          src={d.detailCover ?? d.cover}
          alt={d.detailCover ? (d.detailCoverAlt ?? d.coverAlt) : d.coverAlt}
          widths={[800, 1400, 2000]}
          sizes="96vw"
          loading="eager"
          class="project__cover-img"
          data-cover-img
        />
      </div>
    </div>

    <div class="project__zone">
      <Glow variant="body" />
      <div class="project__body container">
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>

  {
    next && next.slug !== project.slug && (
      <div class="project__zone">
      <Glow variant="soft" />
      <a href={paths.project(lang, next.slug)} class="next container" data-cursor={c.work.view}>
        <span class="mono muted">{c.project.next} →</span>
        <span class="next__title display">{next.data.title}</span>
        <span class="next__media">
          <Image src={next.data.cover} alt="" widths={[640, 960]} sizes="40vw" />
        </span>
      </a>
      </div>
    )
  }
</Base>

<style>
  /* Zóny so žiarou: obsah musí byť nad ňou (position: relative) */
  .project {
    overflow-x: clip;
  }
  .project__zone {
    position: relative;
    overflow-x: clip;
  }
  .project__head,
  .project__body,
  .project__cover {
    position: relative;
  }
  .project__head {
    padding-top: calc(var(--header-h) + clamp(2rem, 6vw, 5rem));
  }
  .project__back {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--muted);
    margin-bottom: clamp(3rem, 8vw, 6rem);
    transition: color 0.3s;
  }
  .project__back:hover {
    color: var(--fg);
  }
  .project__cat {
    display: flex;
    margin-bottom: 1.25rem;
  }
  .project__title {
    font-size: clamp(3rem, 11vw, 12rem);
    font-variation-settings: 'wdth' 118;
    line-height: 0.86;
    text-wrap: balance;
  }
  .project__intro {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    margin-top: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .project__summary {
    grid-column: 1 / span 5;
    font-size: var(--step-1);
    line-height: 1.35;
  }
  .project__meta {
    grid-column: 7 / span 4;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem var(--gutter);
  }
  .project__meta dt {
    margin-bottom: 0.35rem;
  }
  .project__meta dd {
    font-weight: 550;
  }
  .project__live {
    grid-column: 11 / span 2;
    justify-self: end;
  }

  .project__cover {
    margin-top: clamp(4rem, 9vw, 8rem);
  }
  /* Obrázok sa zobrazí celý vo vlastnom pomere strán (mockupy sa neorežú) */
  .project__cover-frame {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .project__cover-img {
    width: 100%;
    height: auto;
  }

  .project__body {
    padding-block: clamp(5rem, 11vw, 10rem);
  }

  .prose {
    max-width: 760px;
    margin-inline: auto;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--muted);
  }
  .prose :global(h2),
  .prose :global(h3) {
    color: var(--fg);
    font-weight: 750;
    font-stretch: 108%;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 2.5em 0 0.7em;
  }
  .prose :global(h2) {
    font-size: var(--step-3);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    font-size: var(--step-2);
  }
  .prose :global(p + p) {
    margin-top: 1em;
  }
  .prose :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent-fg);
    text-underline-offset: 0.2em;
  }
  .prose :global(strong) {
    color: var(--fg);
  }
  .prose :global(ul) {
    list-style: none;
    margin-block: 1em;
  }
  .prose :global(ul li::before) {
    content: '↳ ';
    color: var(--accent-fg);
  }
  .prose :global(img) {
    width: min(100vw - var(--gutter) * 2, 1400px);
    max-width: none;
    margin: 3em 0 3em 50%;
    translate: -50% 0;
    border-radius: var(--radius);
  }
  .prose :global(p:has(> img:only-child)) {
    margin: 0;
  }

  .next {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: clamp(5rem, 10vw, 9rem);
    border-top: 1px solid var(--faint);
  }
  .next__title {
    font-size: clamp(3rem, 10vw, 11rem);
    font-variation-settings: 'wdth' 118;
    transition: color 0.4s;
    position: relative;
    z-index: 1;
  }
  .next:hover .next__title {
    color: var(--accent-fg);
  }
  .next__media {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    width: clamp(220px, 28vw, 440px);
    aspect-ratio: 16 / 11;
    border-radius: var(--radius);
    overflow: hidden;
    translate: 0 -50%;
    rotate: 4deg;
    scale: 0.85;
    opacity: 0;
    transition:
      opacity 0.5s var(--ease-out),
      scale 0.8s var(--ease-out),
      rotate 0.8s var(--ease-out);
  }
  .next__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .next:hover .next__media {
    opacity: 1;
    scale: 1;
    rotate: -2deg;
  }

  @media (max-width: 900px) {
    .project__intro {
      grid-template-columns: 1fr;
    }
    .project__summary,
    .project__meta,
    .project__live {
      grid-column: 1;
      justify-self: start;
    }
    .prose :global(img) {
      width: 100%;
      margin-left: 0;
    }
    .next__media {
      display: none;
    }
  }
</style>
